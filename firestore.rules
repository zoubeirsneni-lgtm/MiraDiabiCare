rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitives & Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || 
        request.auth.token.email == 'zoubeirsneni@gmail.com' ||
        request.auth.token.email == 'snenizoubeir@gmail.com'
      ); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // User Validation
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'diabetesType', 'targetMin', 'targetMax']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.diabetesType in ['type1', 'type2', 'gestational'] &&
             data.targetMin is number && data.targetMin >= 40 && data.targetMin <= 100 &&
             data.targetMax is number && data.targetMax >= 100 && data.targetMax <= 400;
    }

    // Medication Validation
    function isValidMedication(data) {
      return data.keys().hasAll(['userId', 'name', 'dosage', 'stock', 'minStock', 'type']) &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.dosage is string && data.dosage.size() <= 200 &&
             data.stock is number && data.stock >= 0 &&
             data.minStock is number && data.minStock >= 0 &&
             data.type in ['insulin-fast', 'insulin-slow', 'pill', 'other'] &&
             (data.get('createdAt', request.time) == request.time);
    }

    // Log Validation
    function isValidLog(data) {
      return data.keys().hasAll(['userId', 'type', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.type in ['glucose', 'medication', 'activity', 'food', 'weight'] &&
             (data.timestamp == request.time || data.timestamp == null) &&
             (data.get('value', 0) is number || data.get('value', 0) == null) &&
             (data.get('notes', '').size() <= 2000);
    }

    // 4. Collections
    match /users/{userId} {
      allow list: if isAdmin();
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && !incoming().get('isAdmin', false);
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'diabetesType', 'age', 'targetMin', 'targetMax', 'insulinToCarbRatio', 'insulinSensitivityFactor']) ||
                    isAdmin();
    }

    match /logs/{logId} {
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(logId);
      allow update: if isOwner(existing().userId) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['value', 'notes', 'mealType', 'timing', 'medicationName']) ||
                    isAdmin();
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // Admin detection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Google Cloud Console
    }

    match /medications/{medId} {
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidMedication(incoming()) && isValidId(medId);
      allow update: if isOwner(existing().userId) && isValidMedication(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'minStock', 'name', 'dosage', 'type']);
      allow delete: if isOwner(existing().userId) || isAdmin();
    }
  }
}
